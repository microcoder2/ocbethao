{
  "entryFile": "src/index.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": [
    "src/controllers/*Controller.ts"
  ],
  "spec": {
    "outputDirectory": "swagger",
    "specVersion": 3,
    "title": "Oc Be Thao API",
    "version": "0.1.0",
    "description": "API cho he thong van hanh quan oc va order F&B",
    "basePath": "/api",
    "securityDefinitions": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token"
      }
    }
  },
  "routes": {
    "basePath": "/api",
    "routesDir": "src/routes",
    "middleware": "express",
    "authenticationModule": "./src/authentication.ts"
  }
}
