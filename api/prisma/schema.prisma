generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum CustomerType {
  WALK_IN
  REGULAR
  VIP
  OFFICE
  ONLINE
  TOURIST
}

enum MenuItemStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum DailyMenuStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderSource {
  CUSTOMER_APP
  STAFF_POS
  ADMIN_POS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  WAITING
  COOKING
  READY
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  E_WALLET
}

enum InventoryMovementType {
  MENU_POOL_INCREASE
  MENU_POOL_DECREASE
  ORDER_RESERVE
  ORDER_RELEASE
  ORDER_RESTORE
  MANUAL_ADJUST
  CORRECTION
}

model User {
  id                    Int          @id @default(autoincrement())
  fullName              String
  password              String?
  role                  Role
  username              String?      @unique
  phone                 String?      @unique
  email                 String?      @unique
  preferredAuthProvider String?
  customerType          CustomerType?
  avatarUrl             String?      @db.LongText
  notes                 String?      @db.LongText
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  createdMenuItems MenuItem[] @relation("MenuItemCreator")
  createdMenus     DailyMenu[] @relation("DailyMenuCreator")
  createdOrders    Order[]     @relation("OrderCreator")
  assignedOrders   Order[]     @relation("OrderAssignee")
  customerOrders   Order[]     @relation("OrderCustomer")
  createdInventoryMovements InventoryMovement[] @relation("InventoryMovementCreator")
  authIdentities   UserAuthIdentity[]
  authChallenges   AuthChallenge[]
  sessions         UserSession[]
  auditLogs        AuditLog[]
}

model UserAuthIdentity {
  id               Int      @id @default(autoincrement())
  userId           Int
  provider         String
  providerUserId   String
  providerEmail    String?
  providerPhone    String?
  providerUsername String?
  displayName      String?
  avatarUrl        String?  @db.LongText
  emailVerified    Boolean  @default(false)
  phoneVerified    Boolean  @default(false)
  rawProfile       Json?
  linkedAt         DateTime @default(now())
  lastLoginAt      DateTime?
  revokedAt        DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions UserSession[]

  @@unique([provider, providerUserId])
  @@index([userId, provider])
  @@index([providerEmail])
  @@index([providerPhone])
}

model AuthChallenge {
  id                Int      @id @default(autoincrement())
  userId            Int?
  provider          String
  intent            String   @default("login")
  state             String   @unique
  nonce             String?
  codeVerifier      String?  @db.LongText
  redirectUri       String?  @db.LongText
  externalSessionId String?
  expiresAt         DateTime
  consumedAt        DateTime?
  meta              Json?
  createdAt         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, expiresAt])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?  @db.LongText
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MenuItem[]
}

model Ingredient {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?  @db.LongText
  unit        String   @default("phan")
  imageUrl    String?  @db.LongText
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredientPresets MenuItemIngredientPreset[]
  dailyStockPools   DailyStockPool[]
  inventoryMovements InventoryMovement[]
  orderItemConsumptions OrderItemConsumption[]
}

model MenuItem {
  id                 Int            @id @default(autoincrement())
  name               String
  slug               String         @unique
  description        String?        @db.LongText
  unit               String         @default("phan")
  spicyLevel         Int?
  imageUrl           String?        @db.LongText
  currentPrice       Decimal        @db.Decimal(10, 2)
  status             MenuItemStatus @default(ACTIVE)
  isFeatured         Boolean        @default(false)
  isAvailable        Boolean        @default(true)
  preparationTimeMin Int?
  categoryId         Int
  createdById        Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  category          Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy         User?                    @relation("MenuItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  priceHistories    MenuItemPrice[]
  ingredientPresets MenuItemIngredientPreset[]
  dailyMenuItems    DailyMenuItem[]
  orderItems        OrderItem[]

  @@index([categoryId, status])
}

model MenuItemPrice {
  id            Int       @id @default(autoincrement())
  menuItemId    Int
  price         Decimal   @db.Decimal(10, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, effectiveFrom])
  @@unique([menuItemId, effectiveFrom])
}

model MenuItemIngredientPreset {
  id              Int      @id @default(autoincrement())
  menuItemId      Int
  ingredientId    Int
  consumeQuantity Decimal  @default(1) @db.Decimal(10, 2)
  sortOrder       Int      @default(0)
  note            String?  @db.LongText
  createdAt       DateTime @default(now())

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId, sortOrder])
  @@index([ingredientId])
}

model DailyMenu {
  id          Int             @id @default(autoincrement())
  code        String          @unique
  title       String
  serviceDate DateTime        @db.Date
  status      DailyMenuStatus @default(DRAFT)
  note        String?         @db.LongText
  bannerText  String?         @db.LongText
  createdById Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy  User?            @relation("DailyMenuCreator", fields: [createdById], references: [id], onDelete: SetNull)
  stockPools DailyStockPool[]
  items      DailyMenuItem[]
  orders     Order[]
  inventoryMovements InventoryMovement[]

  @@index([serviceDate, status])
}

model DailyStockPool {
  id           Int      @id @default(autoincrement())
  dailyMenuId  Int
  ingredientId Int
  label        String?
  quantity     Decimal  @db.Decimal(10, 2)
  soldQuantity Decimal  @default(0) @db.Decimal(10, 2)
  isAvailable  Boolean  @default(true)
  note         String?  @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dailyMenu   DailyMenu            @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  ingredient  Ingredient           @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  itemLinks   DailyMenuItemStock[]
  inventoryMovements InventoryMovement[]
  orderItemConsumptions OrderItemConsumption[]

  @@index([dailyMenuId, ingredientId])
}

model DailyMenuItem {
  id             Int       @id @default(autoincrement())
  dailyMenuId    Int
  menuItemId     Int
  overridePrice  Decimal?  @db.Decimal(10, 2)
  isAvailable    Boolean   @default(true)
  highlightLabel String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  dailyMenu  DailyMenu            @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  menuItem   MenuItem             @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  stockLinks DailyMenuItemStock[]
  orderItems OrderItem[]

  @@unique([dailyMenuId, menuItemId])
  @@index([menuItemId])
}

model DailyMenuItemStock {
  id               Int      @id @default(autoincrement())
  dailyMenuItemId  Int
  dailyStockPoolId Int
  consumeQuantity  Decimal  @default(1) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  dailyMenuItem DailyMenuItem @relation(fields: [dailyMenuItemId], references: [id], onDelete: Cascade)
  dailyStockPool DailyStockPool @relation(fields: [dailyStockPoolId], references: [id], onDelete: Cascade)

  @@unique([dailyMenuItemId, dailyStockPoolId])
  @@index([dailyStockPoolId])
}

model Order {
  id              Int           @id @default(autoincrement())
  orderNumber     String        @unique
  source          OrderSource
  status          OrderStatus   @default(CONFIRMED)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod?
  tableLabel      String?
  guestCount      Int?
  guestName       String?
  guestPhone      String?
  note            String?       @db.LongText
  internalNote    String?       @db.LongText
  arrivalAt       DateTime?
  subtotal        Decimal       @db.Decimal(10, 2)
  serviceFee      Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  createdById     Int?
  assignedStaffId Int?
  customerId      Int?
  dailyMenuId     Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  confirmedAt     DateTime?
  completedAt     DateTime?

  createdBy    User?      @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedStaff User?     @relation("OrderAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  customer     User?      @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  dailyMenu    DailyMenu? @relation(fields: [dailyMenuId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([status, createdAt])
  @@index([status, arrivalAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  menuItemId      Int?
  dailyMenuItemId Int?
  itemNameSnapshot String
  unitPrice       Decimal  @db.Decimal(10, 2)
  quantity        Int
  waitingQuantity Int      @default(0)
  cookingQuantity Int      @default(0)
  readyQuantity   Int      @default(0)
  cancelledQuantity Int    @default(0)
  status          OrderItemStatus @default(WAITING)
  lineTotal       Decimal  @db.Decimal(10, 2)
  note            String?
  createdAt       DateTime @default(now())

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem?      @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  dailyMenuItem DailyMenuItem? @relation(fields: [dailyMenuItemId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]
  consumptions OrderItemConsumption[]

  @@index([menuItemId])
  @@index([dailyMenuItemId])
  @@index([status])
}

model InventoryMovement {
  id               Int                   @id @default(autoincrement())
  ingredientId     Int
  dailyMenuId      Int?
  dailyStockPoolId Int?
  orderId          Int?
  orderItemId      Int?
  movementType     InventoryMovementType
  quantityDelta    Decimal               @db.Decimal(10, 2)
  note             String?               @db.LongText
  createdById      Int?
  createdAt        DateTime              @default(now())

  ingredient       Ingredient            @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  dailyMenu        DailyMenu?            @relation(fields: [dailyMenuId], references: [id], onDelete: SetNull)
  dailyStockPool   DailyStockPool?       @relation(fields: [dailyStockPoolId], references: [id], onDelete: SetNull)
  order            Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem        OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  createdBy        User?                 @relation("InventoryMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  consumptions     OrderItemConsumption[]

  @@index([ingredientId, createdAt])
  @@index([dailyStockPoolId, createdAt])
  @@index([orderItemId, createdAt])
  @@index([movementType, createdAt])
}

model OrderItemConsumption {
  id                  Int                @id @default(autoincrement())
  orderItemId         Int
  ingredientId        Int
  dailyStockPoolId    Int?
  consumeQuantity     Decimal            @db.Decimal(10, 2)
  totalQuantity       Decimal            @db.Decimal(10, 2)
  inventoryMovementId Int?
  createdAt           DateTime           @default(now())

  orderItem           OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ingredient          Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  dailyStockPool      DailyStockPool?    @relation(fields: [dailyStockPoolId], references: [id], onDelete: SetNull)
  inventoryMovement   InventoryMovement? @relation(fields: [inventoryMovementId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([dailyStockPoolId])
  @@index([inventoryMovementId])
}

model UserSession {
  id               Int      @id @default(autoincrement())
  userId           Int
  authIdentityId   Int?
  loginProvider    String?
  refreshTokenHash String
  ip               String?
  userAgent        String?
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  logoutAt         DateTime?
  revokedAt        DateTime?

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  authIdentity UserAuthIdentity? @relation(fields: [authIdentityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([authIdentityId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
}
